+        False, "--evaluate", help="Run optional scikit-learn benchmark when a target is supplied."
+    ),
+):
+    """Profile, plan, fit, transform, and persist one reproducible local run."""
+    directory = Path(output_dir)
+    df = read_dataset(file_path)
